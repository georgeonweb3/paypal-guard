# Copy this file to ".env" and fill in your SANDBOX app credentials.
# Get them at developer.paypal.com -> Dashboard -> Apps & Credentials -> Sandbox.
# NEVER commit the real .env, never paste these values into chat or an issue.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI layer (only needed for `node demo.mjs agent "<goal>"`).
# Any OpenAI-compatible chat-completions endpoint. The defaults talk to a
# local Ollama server (free, no key): install Ollama, `ollama pull qwen3:4b`,
# and the demo works as recorded. For a hosted endpoint, set the base URL,
# model and key from that provider instead.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:4b
# LLM_API_KEY=
